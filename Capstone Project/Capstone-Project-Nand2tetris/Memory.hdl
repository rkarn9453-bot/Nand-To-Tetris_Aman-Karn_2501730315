CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];
    PARTS:
    // RAM when address[14]=0, Screen when address[14]=1 and address[13]=0
    DMux(in=load, sel=address[14], a=loadRam, b=loadHigh);
    Not(in=address[13], out=notA13);
    And(a=loadHigh, b=notA13, out=loadScr);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScr, address=address[0..12], out=scrOut);
    Keyboard(out=kbdOut);

    And(a=address[14], b=address[13], out=isKbd);
    Mux16(a=ramOut, b=scrOut, sel=address[14], out=o1);
    Mux16(a=o1, b=kbdOut, sel=isKbd, out=out);
}